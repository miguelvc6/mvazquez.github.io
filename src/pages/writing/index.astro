---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import WritingSearch from '../../components/WritingSearch.astro';
import WritingRow from '../../components/WritingRow.astro';
import { publishedWriting } from '../../utils/writing';

const posts = await publishedWriting();
---
<Base title="Writing" description="Technical articles and research notes by Miguel Vázquez, including practical guides to agent workflows and ray tracing.">
  <PageIntro title="Writing" intro="Technical articles and notes on the ideas I learn by implementing them.">
    <a class="text-link" href="/rss.xml">RSS feed <span aria-hidden="true">↗</span></a>
  </PageIntro>
  <div class="wrap page-body">
    <WritingSearch />
    <div class="row-list">{posts.map((post) => <WritingRow post={post} />)}</div>
  </div>
</Base>
