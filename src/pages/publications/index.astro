---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import PublicationRow from '../../components/PublicationRow.astro';
import CopyControls from '../../components/CopyControls.astro';
import { publications, scholarlyArticle } from '../../data/publications';
import { person, profile } from '../../data/profile';

const reviewed = publications.filter((item) => item.status !== 'Submitted manuscript').sort((a, b) => b.year - a.year);
const submitted = publications.filter((item) => item.status === 'Submitted manuscript').sort((a, b) => b.year - a.year);
---
<Base title="Publications" description="Peer-reviewed publications and submitted research by Miguel Vázquez." schema={{ '@graph': [person, ...publications.map(scholarlyArticle)] }}>
  <PageIntro title="Publications" intro="Research on graph neural networks, symbolic verification, and factual errors in language model outputs.">
    <a class="text-link" href={profile.profiles[0].url}>Google Scholar <span aria-hidden="true">↗</span></a>
  </PageIntro>
  <div class="wrap page-body">
    <section aria-labelledby="reviewed">
      <div class="section-heading"><h2 id="reviewed">Peer-reviewed work</h2></div>
      <div class="row-list">{reviewed.map((item) => <PublicationRow item={item} />)}</div>
    </section>
    {submitted.length > 0 && <section class="submitted" aria-labelledby="submitted">
      <div class="section-heading"><h2 id="submitted">Submitted work</h2></div>
      <div class="row-list">{submitted.map((item) => <PublicationRow item={item} />)}</div>
    </section>}
  </div>
  <CopyControls />
</Base>
<style>
  .submitted { margin-top: clamp(3rem, 7vw, 6rem); }
</style>
