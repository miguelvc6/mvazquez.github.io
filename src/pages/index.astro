---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchMap from '../components/ResearchMap.astro';
import PublicationRow from '../components/PublicationRow.astro';
import CourseEntry from '../components/CourseEntry.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import WritingRow from '../components/WritingRow.astro';
import { person, profile } from '../data/profile';
import { directions, researchIntro } from '../data/research';
import { publications } from '../data/publications';
import { news } from '../data/news';
import { teaching } from '../data/teaching';
import { projects } from '../data/projects';
import { displayDate, publishedWriting } from '../utils/writing';

const writing = (await publishedWriting()).slice(0, 2);
---
<Base title={profile.name} description={`${profile.name}, ${profile.role} at ${profile.institution}. ${profile.introduction}`} schema={{ '@type': 'ProfilePage', mainEntity: person }}>
  <section class="wrap hero" id="home" aria-labelledby="home-heading">
    <div class="hero-copy">
      <p class="eyebrow">{profile.role}</p>
      <h1 id="home-heading">Connecting{' '}<br /><em>learning</em> and{' '}<br />reasoning.</h1>
      <p class="hero-intro">{profile.introduction}</p>
      <p class="affiliation"><strong>{profile.institution}</strong><span aria-hidden="true"></span><a href={profile.affiliationUrl}>{profile.affiliation}</a></p>
      <div class="hero-actions">
        <a class="button-link" href="/research/">Explore my research <span aria-hidden="true">↗</span></a>
        <div class="secondary-actions">
          <a class="text-link" href="/publications/">Publications <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={profile.cv} download>CV (PDF) <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
    <figure class="hero-portrait">
      <figcaption class="portrait-caption meta"><span>{profile.name}</span><span>{profile.location}</span></figcaption>
      <div class="portrait-frame">
        <Image src={profile.portrait} alt={`Black-and-white portrait of ${profile.name}`} widths={[400, 640, 900]} sizes="(max-width: 640px) 85vw, (max-width: 900px) 36vw, 420px" loading="eager" fetchpriority="high" />
      </div>
      <div class="portrait-mark" aria-hidden="true">
        <svg viewBox="0 0 74 74" fill="none">
          <path d="M15 19L55 14 60 56 20 59 15 19 60 56M55 14 20 59M15 19 36 35 55 14M20 59 36 35 60 56" />
          <circle cx="15" cy="19" r="4" /><circle cx="55" cy="14" r="4" /><circle cx="60" cy="56" r="4" /><circle cx="20" cy="59" r="4" /><circle cx="36" cy="35" r="5" />
        </svg>
      </div>
    </figure>
  </section>
  <div class="wrap topics" aria-label="Research areas">
    <a href="/research/#repair">Knowledge graphs</a>
    <a href="/research/#verify">Symbolic reasoning</a>
    <a href="/research/#guide">Neural models</a>
  </div>

  <section class="wrap section" id="research" aria-labelledby="research-heading">
    <SectionHeading title="Research" id="research-heading" href="/research/" link="Research directions" />
    <div class="split research-feature">
      <div class="flow">
        <h3>What can a constraint tell us?</h3>
        <p>{researchIntro}</p>
        <ul class="direction-links" role="list">
          {directions.map(({ id, title }) => <li><a href={`/research/#${id}`}>{title}<span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </div>
      <ResearchMap />
    </div>
  </section>

  <section class="band section" id="publications" aria-labelledby="publications-heading">
    <div class="wrap">
      <SectionHeading title="Selected publications" id="publications-heading" href="/publications/" link="All publications" />
      <div class="row-list">
        {publications.filter(({ featured }) => featured).map((item) => <PublicationRow item={item} compact />)}
      </div>
    </div>
  </section>

  <section class="wrap section" id="activity" aria-labelledby="activity-heading">
    <span id="experience" class="legacy-anchor"></span><span id="work" class="legacy-anchor"></span>
    <SectionHeading title="Recent academic activity" id="activity-heading" />
    <ol class="activity-list" role="list">
      {news.slice(0, 4).map(({ date, title, description, link }) => <li class="activity-entry row">
        <time class="meta" datetime={date}>{displayDate(date, { month: 'long', year: 'numeric' })}</time>
        <div><h3>{title}</h3><p>{description}</p>{link && <a class="text-link" href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>}</div>
      </li>)}
    </ol>
  </section>

  <section class="wrap section" id="teaching" aria-labelledby="teaching-heading">
    <SectionHeading title="Teaching" id="teaching-heading" href="/teaching/" link="Courses and supervision" />
    <div class="split teaching-feature">
      <div class="flow">
        <h3>AI in the classroom</h3>
        <p>I teach at WU Vienna and supervise bachelor’s research on Wikidata and factual error detection. For the MSc AI course, I develop lectures and exercises that connect symbolic reasoning with machine learning.</p>
        <a class="text-link" href="/teaching/#thesis-supervision">Thesis supervision <span aria-hidden="true">↗</span></a>
      </div>
      <div>{teaching.filter(({ institution, category }) => institution === profile.institution && category === 'course').slice(0, 2).map((item) => <CourseEntry item={item} compact />)}</div>
    </div>
  </section>

  <div class="band section">
    <div class="wrap split studio">
      <section id="portfolio" aria-labelledby="projects-heading">
        <SectionHeading title="Projects" id="projects-heading" href="/projects/" link="All projects" />
        {projects.filter(({ featured }) => featured).map((item) => <ProjectEntry item={item} compact />)}
      </section>
      <section id="blog" aria-labelledby="writing-heading">
        <SectionHeading title="Writing" id="writing-heading" href="/writing/" link="Writing archive" />
        {writing.map((post) => <WritingRow post={post} compact />)}
      </section>
    </div>
  </div>

  <section class="wrap section about-feature" id="about" aria-labelledby="about-heading">
    <span id="education" class="legacy-anchor"></span><span id="skills" class="legacy-anchor"></span><span id="certificates" class="legacy-anchor"></span>
    <SectionHeading title="A little background" id="about-heading" href="/about/" link="More about me" />
    <div class="split about-copy">
      <h3>From Seville.<br /><em>Based in Vienna.</em></h3>
      <div>
        <p>I studied mathematics and logic in Seville and worked as a data scientist before starting my doctorate. At WU Vienna I work with Axel Polleres in the Bilateral AI Cluster of Excellence.</p>
        <p>Outside research, I make time for books, rugby, and strength training.</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .86fr); gap: clamp(2rem, 7.4vw, 7rem); align-items: center; padding-block: clamp(3.25rem, 6.35vw, 6.3rem) clamp(2.7rem, 5vw, 5rem); }
  .hero h1 { font-size: clamp(3.7rem, 7.2vw, 6.85rem); line-height: .95; margin: .22em 0 .24em; }
  .hero h1 em, .about-copy h3 em { color: var(--accent); font-weight: inherit; }
  .hero-intro { max-width: 32rem; font-size: clamp(1.07rem, 1.7vw, 1.27rem); line-height: 1.56; margin-bottom: 1.2rem; }
  .affiliation { display: flex; align-items: center; flex-wrap: wrap; gap: .18rem .62rem; color: var(--muted); font-size: .95rem; }
  .affiliation strong { color: var(--ink); }
  .affiliation span { width: .25rem; height: .25rem; border-radius: 50%; background: var(--accent); }
  .affiliation a { text-decoration: none; }
  .affiliation a:hover { text-decoration: underline; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem 1.3rem; margin-top: 1.55rem; }
  .secondary-actions { display: flex; align-items: center; gap: 1.3rem; }
  .hero-actions .text-link { font-size: .95rem; padding-block: .42rem; }
  .hero-portrait { position: relative; width: min(100%, 420px); min-width: 0; justify-self: end; padding-inline: .8rem; }
  .portrait-caption { display: flex; justify-content: space-between; gap: .5rem; margin-bottom: .6rem; font-size: .71rem; }
  .portrait-frame { border: 1px solid var(--rule); padding: .56rem; background: var(--panel); }
  .portrait-frame img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 40%; filter: grayscale(1); }
  .portrait-mark { position: absolute; right: 0; bottom: -.72rem; width: clamp(3.25rem, 7vw, 5rem); background: var(--paper); border: 1px solid var(--rule); color: var(--accent); }
  .portrait-mark svg { width: 100%; stroke: currentColor; stroke-width: 1.1; }
  .portrait-mark circle { fill: var(--paper); }
  .topics { display: flex; gap: .25rem clamp(.5rem, 2.8vw, 2.3rem); flex-wrap: wrap; border-block: 1px solid var(--rule); padding-block: .65rem; }
  .topics a { padding-block: .28rem; color: var(--muted); font-size: .85rem; font-weight: 650; text-decoration: none; }
  .topics a:hover { color: var(--accent); text-decoration: underline; }
  .topics a + a::before { content: '·'; display: inline-block; color: var(--accent); margin-right: clamp(.5rem, 2.8vw, 2.3rem); }
  .research-feature, .teaching-feature, .about-copy { padding-top: var(--space-row); align-items: start; }
  .research-feature h3, .teaching-feature h3 { font-size: clamp(1.85rem, 3.5vw, 3rem); }
  .direction-links { list-style: none; padding: 0; border-top: 1px solid var(--rule); }
  .direction-links a { display: flex; justify-content: space-between; gap: .75rem; padding-block: .65rem; border-bottom: 1px solid var(--rule); font-size: .93rem; font-weight: 630; text-decoration: none; }
  .direction-links span { color: var(--accent); }
  .activity-list { margin: 0; padding: 0; list-style: none; }
  .activity-entry { display: grid; grid-template-columns: minmax(8rem, .26fr) minmax(0, 1fr); gap: .45rem clamp(1rem, 5vw, 4rem); }
  .activity-entry time { color: var(--accent); }
  .activity-entry p { margin-bottom: .25rem; }
  .activity-entry a { font-size: .9rem; }
  .teaching-feature :global(.course:first-child) { padding-top: 0; }
  .studio { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2.2rem, 7vw, 7rem); }
  .about-copy h3 { font-size: clamp(2.5rem, 5vw, 4.7rem); max-width: 14ch; }
  .legacy-anchor { display: block; }
  @media (max-width: 950px) {
    .hero { gap: 2rem; }
    .hero h1 { font-size: clamp(3.3rem, 7.7vw, 5.2rem); }
    .hero-portrait { padding-inline: 0 .6rem; }
  }
  @media (max-width: 640px) {
    .hero, .studio { grid-template-columns: minmax(0, 1fr); }
    .hero { gap: 2rem; }
    .hero-actions { align-items: start; flex-direction: column; }
    .hero h1 { font-size: clamp(3.45rem, 12vw, 5.3rem); }
    .hero-portrait { justify-self: start; width: min(86%, 21rem); }
    .activity-entry { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 360px) {
    .hero h1 { font-size: 3.17rem; }
    .hero-portrait { width: min(100%, 17rem); }
  }
</style>
