---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../../layouts/Base.astro';
import CopyControls from '../../../../components/CopyControls.astro';
import { articleUrl } from '../../../../utils/urls';
import { displayDate, publishedWriting, readingTime, type Post } from '../../../../utils/writing';
import { person, profile } from '../../../../data/profile';
import '../../../../styles/article.css';

export const getStaticPaths = (async () => {
  const posts = await publishedWriting();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, older: posts[index + 1], newer: posts[index - 1] },
  }));
}) satisfies GetStaticPaths;

interface Props { post: Post; older?: Post; newer?: Post }
const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, summary, tags, image } = post.data;
const url = articleUrl(post.id);
const contents = headings.filter(({ depth, slug }) => depth <= 3 && slug !== "footnote-label");
const minutes = readingTime(post.body ?? '');
---
<Base title={title} description={summary} canonicalPath={url} image={image} type="article" schema={{
  '@graph': [person, {
    '@type': 'BlogPosting', headline: title, description: summary, datePublished: date,
    url: new URL(url, Astro.site).href, author: { '@id': person['@id'] }, keywords: tags,
    ...(image ? { image: new URL(image, Astro.site).href } : {}),
  }],
}}>
  <meta slot="head" property="article:published_time" content={date} />
  <article class="wrap post">
    <header class="post-header">
      <a class="text-link" href="/writing/"><span aria-hidden="true">← </span>Writing</a>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <p class="post-byline">{profile.name} · <time datetime={date}>{displayDate(date)}</time> · {minutes} min read</p>
      <p class="post-tags">{tags.join(' · ')}</p>
    </header>
    <div class:list={['post-layout', { 'has-toc': contents.length >= 4 }]}>
      {contents.length >= 4 && (
        <aside class="post-aside">
          <details open>
            <summary>On this page</summary>
            <nav aria-label="Article contents">
              <ul role="list">
                {contents.map(({ slug, text, depth }) => (
                  <li class:list={[{ nested: depth > 2 }]}><a href={`#${encodeURIComponent(slug)}`}>{text}</a></li>
                ))}
              </ul>
            </nav>
          </details>
        </aside>
      )}
      <div class="article-body"><Content /></div>
    </div>
    {(older || newer) && <nav class="post-neighbors" aria-label="More articles">
      {older && <a href={articleUrl(older.id)}><span class="meta">← Earlier article</span><span>{older.data.title}</span></a>}
      {newer && <a href={articleUrl(newer.id)}><span class="meta">Newer article →</span><span>{newer.data.title}</span></a>}
    </nav>}
  </article>
  <CopyControls />
</Base>
