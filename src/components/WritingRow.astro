---
import { articleUrl } from '../utils/urls';
import { displayDate, readingTime, type Post } from '../utils/writing';

interface Props { post: Post; compact?: boolean }
const { post, compact = false } = Astro.props;
const { title, date, summary, tags } = post.data;
---
<article class="row writing-row" data-writing-result={compact ? undefined : articleUrl(post.id)}>
  <p class="meta"><time datetime={date}>{displayDate(date)}</time>{!compact && ` · ${readingTime(post.body ?? '')} min read`}</p>
  <div>
    <h3><a href={articleUrl(post.id)}>{title} <span class="arrow" aria-hidden="true">↗</span></a></h3>
    <p>{summary}</p>
    {!compact && <p class="tags">{tags.join(' · ')}</p>}
  </div>
</article>
<style>
  .writing-row h3 a { text-decoration: none; }
  .writing-row h3 a:hover { text-decoration: underline; }
  .arrow { color: var(--accent); font: 650 .7em var(--sans); white-space: nowrap; }
  .tags { color: var(--accent); font-size: .88rem; font-weight: 620; }
</style>
